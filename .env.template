# Copy to .env and replace the fake values with your own.
#   cp .env.template .env

# Azure AI Foundry
FOUNDRY_PROJECT_ENDPOINT="https://example-foundry.services.ai.azure.com/api/projects/example-project"
FOUNDRY_API_KEY="replace-with-your-foundry-api-key"
MODEL_DEPLOYMENT_NAME="gpt-4o"
# MODEL_DEPLOYMENT_NAME="gpt-5-mini"
TEXT_EMBEDDING_MODEL_NAME="text-embedding-3-small"
REASONING_EFFORT="minimal"

# HR memory (Azure Foundry Memory Store)
HR_MEMORY_STORE_NAME="hr-joiner-memory"
HR_MEMORY_PROFILE_DETAILS="food preferences, personal interests, and resumes"
HR_MEMORY_MAX_MEMORIES="5"
HR_MEMORY_STORE_TURNS="false"

# API
API_HOST="0.0.0.0"
API_PORT="8000"
API_ALLOWED_HOSTS="*"

# Database: mongodb (local Docker default) or cosmosdb
DB_TECHNOLOGY="mongodb"
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DATABASE="daily_briefs"
# MONGODB_MAX_POOL_SIZE="500"
# MONGODB_MIN_POOL_SIZE="50"
# MONGODB_COLLECTION_CHATHISTORY=""
# MONGODB_COLLECTION_CHATSESSION=""
# MONGODB_COLLECTION_CHATUSER=""

# Cosmos DB (only when DB_TECHNOLOGY=cosmosdb)
